@inherits WAComponentBase
<wa-stepper @ref="@Element"
         id="@Id"
         @attributes="@AdditionalAttributes"
         style="@StyleNames"
         class="@ClassNames"
         slot="@Slot"
         active="@ActiveStep"
         clickable="@Clickable"
         label="@Label"
         linear="@Linear"
         orientation="@OrientationString"
         >
    @ChildContent
</wa-stepper>

